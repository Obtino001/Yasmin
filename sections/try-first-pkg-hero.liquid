{% schema %}
{
  "name": "Landing Package Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Top Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Try your first Yasemin package for only €50"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement Link Text",
      "default": "Order now"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "announcement_bg_color",
      "label": "Announcement Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Landing Page Header"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 130
    },
    {
      "type": "text",
      "id": "header_btn_text",
      "label": "Header Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "header_btn_link",
      "label": "Header Button Link"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_btn_bg",
      "label": "Header Button Background Color",
      "default": "#231f5c"
    },
    {
      "type": "color",
      "id": "header_btn_color",
      "label": "Header Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Hero Card Settings"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Background Video (Shopify-hosted)",
      "info": "Takes priority over image and video URL."
    },
    {
      "type": "video_url",
      "id": "hero_video_url",
      "accept": ["youtube", "vimeo"],
      "label": "YouTube or Vimeo Video URL",
      "info": "Used if no Shopify video is selected."
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop Hero Card Height",
      "default": 540
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile Hero Card Height",
      "default": 400
    },
    {
      "type": "range",
