{%- style -%}
  /* Hide default theme header & announcement bar on this landing page */
  .ym-moving-bar,
  #shopify-section-header,
  #shopify-section-announcement-bar,
  .shopify-section-group-header-group > *:not([id*="cart-drawer"]) {
    display: none !important;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Announcement Bar */
  .landing-announcement {
    background-color: {{ section.settings.announcement_bg_color }};
    color: {{ section.settings.announcement_text_color }};
    text-align: center;
    padding: 10px 16px;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .landing-announcement a {
    color: {{ section.settings.announcement_text_color }};
    text-decoration: underline;
    font-weight: 700;
    margin-left: 0.5rem;
  }

  /* Custom Header */
  .landing-header {
    background-color: {{ section.settings.header_bg_color }};
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .landing-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .landing-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .landing-header__logo img {
    height: auto;
    max-width: 100%;
    display: block;
  }
  .landing-header__logo-text {
    font-size: 2.6rem;
    font-weight: 900;
    color: #231f5c;
    letter-spacing: -0.05rem;
  }
  .landing-header__cta {
    background-color: {{ section.settings.header_btn_bg }};
    color: {{ section.settings.header_btn_color }};
    padding: 16px 30px;
    border-radius: 16px;
    font-size: 1.6rem;
    font-weight: 700;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 6px 20px rgba(35, 31, 92, 0.22);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, filter 0.35s ease;
  }

  .landing-header__cta::after,
  .landing-hero__btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 55%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    transition: left 0.55s ease;
    pointer-events: none;
  }

  .landing-header__cta:hover,
  .landing-hero__btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 32px rgba(35, 31, 92, 0.32);
    filter: brightness(1.06);
  }

  .landing-header__cta:hover::after,
  .landing-hero__btn:hover::after {
    left: 160%;
  }

  .landing-header__cta:active,
  .landing-hero__btn:active {
    transform: translateY(-1px) scale(1.01);
    transition-duration: 0.12s;
  }

  /* Hero Banner Card */
  .landing-hero-card {
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background-color: #00000066;
    /* box-shadow: 0 10px 30px rgba(0,0,0,0.08); */
    min-height: {{ section.settings.mobile_height | default: 460 }}px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  @media screen and (min-width: 750px) {
    .landing-hero-card {
      min-height: {{ section.settings.desktop_height | default: 540 }}px;
    }
  }
  .landing-hero-card__bg,
  .landing-hero-card__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    border: none;
  }
  .landing-hero-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #00000066;
    z-index: 2;
  }
  .landing-hero-card__content {
    position: relative;
    z-index: 3;
    padding: 7rem 2rem 5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .landing-hero__rating {
    background: #FFFFFF21;
    backdrop-filter: blur(4px);
    color: #ffffff;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 1.35rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2rem;
  }
  .landing-hero__rating-stars {
    color: #FFB800;
    letter-spacing: 2px;
  }

  .landing-hero__title {
    color: #ffffff;
    font-size: clamp(2.6rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1.2rem;
  }
  .landing-hero__subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    font-weight: 500;
    margin: 0 0 3rem;
    max-width: 650px;
  }

  .landing-hero__btn {
    background-color: {{ section.settings.hero_btn_bg }};
    color: {{ section.settings.hero_btn_color }};
    padding: 16px 38px;
    border-radius: 16px;
    font-size: 1.5rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, filter 0.35s ease;
  }
  .landing-hero__offer-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 1.4rem;
  }

  /* Features Strip */
  .landing-hero__features {
    position: relative;
    z-index: 3;
    background-color: {{ section.settings.features_bg_color }};
    color: {{ section.settings.features_text_color }};
    padding: 2.4rem 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .landing-hero__features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width:750px) {
    .landing-hero__features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (min-width: 990px) {
    .landing-hero__features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

    @media screen and (max-width:750px) {
.landing-feature-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

  .landing-hero__features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    }
  .landing-feature-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    font-size: 1.45rem;
    font-weight: 600;
  }
  .landing-feature-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.6rem;
    height: 4.6rem;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .landing-feature-item__icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-header__cta,
    .landing-hero__btn,
    .landing-header__cta::after,
    .landing-hero__btn::after {
      transition: none;
    }

    .landing-header__cta::after,
    .landing-hero__btn::after {
      display: none;
    }

    .landing-header__cta:hover,
    .landing-hero__btn:hover {
      transform: none;
      filter: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.show_announcement -%}
    <div class="landing-announcement">
      {{ section.settings.announcement_text }}
      {%- if section.settings.announcement_link != blank and section.settings.announcement_link_text != blank -%}
        <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_link_text }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <header class="landing-header">
    <div class="page-width">
      <div class="landing-header__inner">
        <a href="{{ routes.root_url }}" class="landing-header__logo">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {%- elsif settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {%- else -%}
            <span class="landing-header__logo-text">Yasemin</span>
          {%- endif -%}
        </a>

        {%- if section.settings.header_btn_text != blank -%}
          <a href="{{ section.settings.header_btn_link | default: '#order' }}" class="landing-header__cta">
            {{ section.settings.header_btn_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="page-width section-{{ section.id }}-padding">
    <div class="landing-hero-card">
      {%- if section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'landing-hero-card__video' }}
      {%- elsif section.settings.hero_video_url != blank -%}
        {%- if section.settings.hero_video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.hero_video_url.id }}?enablejsapi=1&autoplay=1&mute=1&loop=1&playlist={{ section.settings.hero_video_url.id }}&controls=0"
            class="landing-hero-card__video"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        {%- elsif section.settings.hero_video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.hero_video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
            class="landing-hero-card__video"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      {%- elsif section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1800 }}"
          alt="{{ section.settings.heading | escape }}"
          class="landing-hero-card__bg"
          width="1800"
          height="800"
          loading="eager"
        >
      {%- else -%}
        <img
          src="https://cdn.shopify.com/s/files/1/0680/1653/7841/files/20790bbd2709fda956dd58d1f5ec00c18cbfd86c.jpg?v=1710000000"
          alt="Turkish Meals"
          class="landing-hero-card__bg"
          width="1800"
          height="800"
          loading="eager"
        >
      {%- endif -%}

      <div class="landing-hero-card__overlay"> </div>

      <div class="landing-hero-card__content">
        {%- if section.settings.rating_text != blank -%}
          <div class="landing-hero__rating">
            <span class="landing-hero__rating-stars">{{ section.settings.rating_stars }}</span>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="landing-hero__title">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="landing-hero__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.hero_btn_text != blank -%}
          <a href="{{ section.settings.hero_btn_link | default: '#order' }}" class="landing-hero__btn">
            {{ section.settings.hero_btn_text }}
          </a>
        {%- endif -%}

        {%- if section.settings.hero_offer_text != blank -%}
          <p class="landing-hero__offer-text">{{ section.settings.hero_offer_text }}</p>
        {%- endif -%}
      </div>
      
          <div class="landing-hero__features">
            <div class="landing-hero__features-grid">
              {%- for block in section.blocks -%}
                <div class="landing-feature-item" {{ block.shopify_attributes }}>
                  <div class="landing-feature-item__icon">
