      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "announcement_bg_color",
      "label": "Announcement Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Landing Page Header"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 130
    },
    {
      "type": "text",
      "id": "header_btn_text",
      "label": "Header Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "header_btn_link",
      "label": "Header Button Link"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_btn_bg",
      "label": "Header Button Background Color",
      "default": "#231f5c"
    },
    {
      "type": "color",
      "id": "header_btn_color",
      "label": "Header Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Hero Card Settings"
