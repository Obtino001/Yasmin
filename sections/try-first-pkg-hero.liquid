{%- style -%}
  /* Hide default theme header & announcement bar on this landing page */
  .ym-moving-bar,
  #shopify-section-header,
  #shopify-section-announcement-bar,
  .shopify-section-group-header-group > *:not([id*="cart-drawer"]) {
    display: none !important;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Announcement Bar */
  .landing-announcement {
    background-color: {{ section.settings.announcement_bg_color }};
    color: {{ section.settings.announcement_text_color }};
    text-align: center;
    padding: 10px 16px;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .landing-announcement a {
    color: {{ section.settings.announcement_text_color }};
    text-decoration: underline;
    font-weight: 700;
    margin-left: 0.5rem;
  }

  /* Custom Header */
  .landing-header {
    background-color: {{ section.settings.header_bg_color }};
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .landing-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .landing-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .landing-header__logo img {
    height: auto;
    max-width: 100%;
    display: block;
  }
  .landing-header__logo-text {
    font-size: 2.6rem;
    font-weight: 900;
    color: #231f5c;
    letter-spacing: -0.05rem;
  }
  .landing-header__cta {
    background-color: {{ section.settings.header_btn_bg }};
    color: {{ section.settings.header_btn_color }};
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .landing-header__cta:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  /* Hero Banner Card */
  .landing-hero-card {
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background-color: #1d184f;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }
  .landing-hero-card__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .landing-hero-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}), rgba(29,24,79,0.85));
    z-index: 2;
  }
  .landing-hero-card__content {
    position: relative;
    z-index: 3;
    padding: 7rem 2rem 5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .landing-hero__rating {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    color: #ffffff;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 1.35rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2rem;
  }
  .landing-hero__rating-stars {
    color: #FFB800;
    letter-spacing: 2px;
  }

  .landing-hero__title {
    color: #ffffff;
    font-size: clamp(2.6rem, 4.5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.2rem;
    max-width: 780px;
  }
  .landing-hero__subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    font-weight: 500;
    margin: 0 0 3rem;
    max-width: 650px;
  }

  .landing-hero__btn {
    background-color: {{ section.settings.hero_btn_bg }};
    color: {{ section.settings.hero_btn_color }};
    padding: 16px 38px;
    border-radius: 50px;
    font-size: 1.5rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03rem;
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .landing-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.25);
  }
  .landing-hero__offer-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 1.4rem;
  }

  /* Features Strip */
  .landing-hero__features {
    position: relative;
    z-index: 3;
    background-color: {{ section.settings.features_bg_color }};
    color: {{ section.settings.features_text_color }};
    padding: 2.4rem 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .landing-hero__features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media screen and (min-width: 600px) {
    .landing-hero__features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (min-width: 990px) {
    .landing-hero__features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .landing-feature-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    font-size: 1.45rem;
    font-weight: 600;
  }
  .landing-feature-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .landing-feature-item__icon svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.show_announcement -%}
    <div class="landing-announcement">
      {{ section.settings.announcement_text }}
      {%- if section.settings.announcement_link != blank and section.settings.announcement_link_text != blank -%}
        <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_link_text }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <header class="landing-header">
    <div class="page-width">
      <div class="landing-header__inner">
        <a href="{{ routes.root_url }}" class="landing-header__logo">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {%- elsif settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {%- else -%}
            <span class="landing-header__logo-text">Yasemin</span>
          {%- endif -%}
        </a>

        {%- if section.settings.header_btn_text != blank -%}
          <a href="{{ section.settings.header_btn_link | default: '#order' }}" class="landing-header__cta">
            {{ section.settings.header_btn_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="page-width section-{{ section.id }}-padding">
    <div class="landing-hero-card">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1800 }}"
          alt="{{ section.settings.heading | escape }}"
          class="landing-hero-card__bg"
          width="1800"
          height="800"
          loading="eager"
        >
      {%- else -%}
        <img
          src="https://cdn.shopify.com/s/files/1/0680/1653/7841/files/20790bbd2709fda956dd58d1f5ec00c18cbfd86c.jpg?v=1710000000"
          alt="Turkish Meals"
          class="landing-hero-card__bg"
          width="1800"
          height="800"
          loading="eager"
        >
      {%- endif -%}

      <div class="landing-hero-card__overlay"></div>

      <div class="landing-hero-card__content">
        {%- if section.settings.rating_text != blank -%}
          <div class="landing-hero__rating">
            <span class="landing-hero__rating-stars">{{ section.settings.rating_stars }}</span>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="landing-hero__title">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="landing-hero__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.hero_btn_text != blank -%}
          <a href="{{ section.settings.hero_btn_link | default: '#order' }}" class="landing-hero__btn">
            {{ section.settings.hero_btn_text }}
          </a>
        {%- endif -%}

        {%- if section.settings.hero_offer_text != blank -%}
          <p class="landing-hero__offer-text">{{ section.settings.hero_offer_text }}</p>
        {%- endif -%}
      </div>

      <div class="landing-hero__features">
        <div class="landing-hero__features-grid">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="landing-feature-item" {{ block.shopify_attributes }}>
                <div class="landing-feature-item__icon">
                  {%- case block.settings.icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                    {%- when 'snowflake' -%}
                      <svg viewBox="0 0 24 24"><line x1="12" y1="2" x2="12" y2="22"></line><line x1="17" y1="7" x2="7" y2="17"></line><line x1="7" y1="7" x2="17" y2="17"></line><line x1="20" y1="12" x2="4" y2="12"></line></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {%- endcase -%}
                </div>
                <span>{{ block.settings.title }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
