{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .landing-cta-box {
    background-color: {{ section.settings.box_bg_color }};
    border-radius: 24px;
    padding: 5rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: flex-start;
  }

  @media screen and (min-width: 900px) {
    .landing-cta-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 6rem 5rem;
    }
  }

  .landing-cta-box__left {
    max-width: 680px;
  }

  .landing-cta-box__title {
    color: #231f5c;
    font-size: clamp(2.6rem, 3.8vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.2rem;
  }

  .landing-cta-box__subtitle {
    color: #55536e;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    margin: 0;
  }

  .landing-cta-box__btn {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: 18px 40px;
    border-radius: 16px;
    font-size: 1.5rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(35, 31, 92, 0.25);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .landing-cta-box__btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="landing-cta-box">
      <div class="landing-cta-box__left">
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-cta-box__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="landing-cta-box__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="landing-cta-box__right">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#order' }}" class="landing-cta-box__btn">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing Bottom CTA Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "box_bg_color",
      "label": "Banner Background Color",
      "default": "#f6f5f0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start Enjoying Homemade Turkish Meals Today"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FIRST PACKAGE €50"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "CLAIM MY OFFER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#231f5c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Landing Bottom CTA Banner"
    }
  ]
}
{% endschema %}
