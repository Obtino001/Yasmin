                          {%- assign ingredient_stripped = ingredient | strip | remove: '•' | remove: '●' | remove: '⚫' | remove: '◆' | remove: '■' | remove: '-' | remove: '*' | remove: '✔' | remove: '✓' | strip -%}
                          {%- if ingredient_stripped != blank -%}
                            <li>
                              <svg viewBox="0 0 24 24" width="14" height="14" style="flex-shrink: 0;">
                                <circle cx="12" cy="12" r="10" fill="#534AB7"/>
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="#FFFFFF"/>
                              </svg>
                              {{ ingredient_stripped }}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              <span class="dish-card__title">{{ block.settings.custom_title | default: 'Chicken Dish' }}</span>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_banner -%}
      <div class="weekly-menu-banner h2 color-{{ section.settings.banner_color_scheme }} gradient">
        {%- if section.settings.banner_title != blank -%}
          <h2>{{ section.settings.banner_title }}</h2>
        {%- endif -%}
        {%- if section.settings.banner_text != blank -%}
          <p class="banner-subtext">{{ section.settings.banner_text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#order' }}" class="weekly-menu-banner__btn">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
{
  "name": "Weekly Menu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "This Week’s Menu",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Main color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Bottom Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "default": true,
      "label": "Show bottom banner"
    },
    {
      "type": "inline_richtext",
      "id": "banner_title",
      "default": "Ready to skip cooking this week?",
      "label": "Banner heading"
    },
    {
      "type": "inline_richtext",
      "id": "banner_text",
      "default": "Get Your First Yasemin Package For €50",
      "label": "Banner subtext"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Order Now",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "banner_color_scheme",
      "label": "Banner color scheme",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "dish",
      "name": "Dish",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Dish Title",
          "default": "Chicken Dish"
        },
        {
          "type": "text",
          "id": "custom_ingredients",
          "label": "Custom Ingredients (comma separated)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Dish Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Weekly Menu",
      "blocks": [
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } },
        { "type": "dish", "settings": { "custom_title": "Chicken Dish" } }
      ]
    }
  ]
}
{% endschema %}