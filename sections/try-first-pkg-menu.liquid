                      src="https://cdn.shopify.com/s/files/1/0680/1653/7841/files/20790bbd2709fda956dd58d1f5ec00c18cbfd86c.jpg?v=1710000000"
                      alt="Chicken Dish"
                      width="400"
                      height="400"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>
                {%- if ingredients_raw != blank -%}
                  <div class="product-info-icon-wrapper" tabindex="0">
                    <button class="product-info-icon-btn" aria-label="Ingredients" type="button">
