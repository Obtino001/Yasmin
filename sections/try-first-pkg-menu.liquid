                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              <a href="{{ prod.url | default: '#' }}" class="dish-card__title-link">
                <span class="dish-card__title">{{ prod.title | default: block.settings.custom_title }}</span>
              </a>
            </div>
          {%- else -%}
            {%- assign ingredients_raw = block.settings.custom_ingredients -%}
            <div class="dish-card">
              <div class="dish-card__media-wrapper">
                <div class="dish-card__media">
                  {%- if block.settings.custom_image != blank -%}
                    <img
                      src="{{ block.settings.custom_image | image_url: width: 600 }}"
                      alt="{{ block.settings.custom_title | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                    >
                  {%- else -%}
