{{ 'component-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .weekly-menu-title {
    color: #231f5c;
    font-size: clamp(2.8rem, 4vw,4rem);
    font-weight: 800;
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .dish-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    transition: transform 0.2s ease;
  }
  
  .dish-card:hover {
    transform: translateY(-4px);
  }

  .dish-card__media-wrapper {
    position: relative;
    width: 100%;
  }

  .dish-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    /* Background color and padding removed for full-width image */
  }
  
  .dish-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Fills the container cleanly */
    transition: transform 0.3s ease;
    border-radius: 20px; /* Applies radius directly to the image */
  }
  
  .dish-card:hover .dish-card__media img {
    transform: scale(1.05);
  }

  .dish-card__title-link {
    text-decoration: none;
    display: block;
    width: 100%;
  }

  .dish-card__title {
    color: #231f5c;
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 1.4rem;
    text-align: center;
    display: block;
    transition: color 0.2s ease;
  }

  .dish-card:hover .dish-card__title {
    color: #534ab7;
  }

  .dish-card__media-wrapper:hover .product-info-dropdown,
  .dish-card:hover .product-info-dropdown,
  .product-info-icon-wrapper:hover .product-info-dropdown,
  .product-info-icon-wrapper:focus-within .product-info-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .weekly-menu-banner {
    margin-top: 5rem;
    padding: 5rem 2.5rem;
    text-align: center;
    border-radius: 24px;
    background-color: #f6f5f0;
    color: #231f5c;
  }

  .weekly-menu-banner h2 {
    color: #26215C;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .weekly-menu-banner .banner-subtext {
    margin: 0 0 2.5rem;
    font-size: 1.6rem;
    font-weight: 500;
    color: #55536e;
  }

  .weekly-menu-banner__btn {
    background-color: #231f5c;
    color: #ffffff;
    padding: 15px 36px;
    border-radius: 16px;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 6px 20px rgba(35, 31, 92, 0.22);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, filter 0.35s ease;
  }

  .weekly-menu-banner__btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 55%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    transition: left 0.55s ease;
    pointer-events: none;
  }

  .weekly-menu-banner__btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 32px rgba(35, 31, 92, 0.32);
    filter: brightness(1.06);
  }

  .weekly-menu-banner__btn:hover::after {
    left: 160%;
  }

  .weekly-menu-banner__btn:active {
    transform: translateY(-1px) scale(1.01);
    transition-duration: 0.12s;
  }

  @media (prefers-reduced-motion: reduce) {
    .weekly-menu-banner__btn,
    .weekly-menu-banner__btn::after {
      transition: none;
    }

    .weekly-menu-banner__btn::after {
      display: none;
    }

    .weekly-menu-banner__btn:hover {
      transform: none;
      filter: none;
    }
  }

  @media screen and (max-width: 749px) {
    .grid--2-col .grid__item {
      width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
      max-width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
    }
    
    .dish-card__title {
      font-size: 1.4rem;
      margin-top: 1rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
